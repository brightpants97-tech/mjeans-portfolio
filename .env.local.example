# 관리자 페이지(/admin)와 유튜브 자동 조회 기능에 필요한 환경변수입니다.
# 실제 값은 이 파일이 아니라 Vercel 프로젝트 설정(Environment Variables)에 등록하세요.
# 로컬에서 테스트하려면 이 파일을 복사해 .env.local로 저장하고 값을 채우세요. (.env.local은 git에 커밋되지 않습니다.)

# 관리자 페이지 로그인 비밀번호
ADMIN_PASSWORD=

# YouTube Data API v3 키 (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# data/works.json 파일에 커밋할 권한을 가진 GitHub Personal Access Token
# (Fine-grained token: 이 저장소에 Contents 읽기/쓰기 권한만 부여하는 것을 권장)
GITHUB_TOKEN=

# 저장소 정보
GITHUB_OWNER=brightpants97-tech
GITHUB_REPO=mjeans-portfolio
GITHUB_BRANCH=main
